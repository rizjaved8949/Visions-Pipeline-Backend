# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
env/
.venv/

# Registered face data & session artifacts (runtime data, not source -
# regenerated by the app; also wiped automatically on every backend start)
Attendance/Faces/*
attendance_sessions.csv

# Marker set once requirements.txt has been pip-installed by app.py
.deps_installed

# IDE
.vscode/

# OS
.DS_Store
Thumbs.db

# Guard monitoring runtime data
local_data/guard/uploads/*
!local_data/guard/uploads/.gitkeep
local_data/guard/outputs/*
!local_data/guard/outputs/.gitkeep
local_data/guard/*.sqlite3
local_data/guard/*.sqlite3-*

# Downloaded at runtime by guard_monitoring/io.py to enable browser-playable H.264 output
local_data/guard/codecs/

# Kitchen monitoring runtime data
local_data/kitchen/uploads/*
local_data/kitchen/sessions/*
local_data/kitchen/reports/*
local_data/kitchen/*.db

# Restricted zone monitor runtime data (session-scoped - drawn/recorded fresh
# every run, wiped once a report is downloaded; never meant to persist)
local_data/restricted_zone/uploads/*
!local_data/restricted_zone/uploads/.gitkeep
local_data/restricted_zone/snapshots/*
!local_data/restricted_zone/snapshots/.gitkeep

# Model weights are intentionally tracked (via Git LFS, see .gitattributes) so a
# fresh clone + `python app.py` works with no manual file copying.
