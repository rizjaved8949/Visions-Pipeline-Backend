# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
env/
.venv/

# Registered face data & session artifacts (runtime data, not source -
# regenerated by the app; also wiped automatically on every backend start)
Attendance/Faces/*
attendance_sessions.csv

# Marker set once requirements.txt has been pip-installed by app.py
.deps_installed

# IDE
.vscode/

# OS
.DS_Store
Thumbs.db

# Guard monitoring runtime data
Guard_monotoring/local_data/guard/uploads/*
!Guard_monotoring/local_data/guard/uploads/.gitkeep
Guard_monotoring/local_data/guard/outputs/*
!Guard_monotoring/local_data/guard/outputs/.gitkeep
Guard_monotoring/local_data/guard/*.sqlite3
Guard_monotoring/local_data/guard/*.sqlite3-*

# Guard model weights
Guard_monotoring/weights/guard/*
!Guard_monotoring/weights/guard/.gitkeep
