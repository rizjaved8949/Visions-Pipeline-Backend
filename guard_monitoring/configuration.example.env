# REFERENCE ONLY: selectively copy settings into the existing root .env.
# This file is not loaded automatically. Preserve existing model paths.
GUARD_TEST_MODE=false
GUARD_RULE_WARMUP_SECONDS=5
GUARD_SLEEP_SECONDS=30
GUARD_PHONE_SECONDS=30
GUARD_STATIONARY_SECONDS=60
GUARD_ABSENCE_SECONDS=30

# Selection and evidence lifetime, in seconds.
GUARD_SELECTION_CONFIRM_SECONDS=1
GUARD_CANDIDATE_GAP_SECONDS=0.5
GUARD_PRESENCE_GRACE_SECONDS=2
GUARD_SELECTION_RELEASE_SECONDS=5
GUARD_UNKNOWN_RESET_SECONDS=5
GUARD_MAX_EVIDENCE_GAP_SECONDS=2
GUARD_TRACK_LOST_BUFFER=120
# Optional time override; evaluate identity association before increasing it.
# GUARD_TRACK_LOST_SECONDS=4

# Presentation only; these do not replace alert durations.
GUARD_ACTIVITY_CONFIRM_SECONDS=0.4
GUARD_ACTIVITY_SLEEP_CONFIRM_SECONDS=0.4
GUARD_ACTIVITY_HOLD_SECONDS=1

# Time-based cache expiry, additionally bounded by existing frame limits.
GUARD_POSE_CACHE_SECONDS=0.75
GUARD_PHONE_CACHE_SECONDS=0.75
GUARD_EYES_CACHE_SECONDS=0.75

# Movement jitter handling.
GUARD_MOVEMENT_HISTORY_SECONDS=5
GUARD_MOVEMENT_MIN_HISTORY_SECONDS=2
GUARD_STATIONARY_RADIUS_RATIO=0.035
GUARD_MOVEMENT_SMOOTHING_SECONDS=0.25
GUARD_MOVEMENT_RADIUS_QUANTILE=0.90

# Sleep qualification before the event timer.
GUARD_MIN_EYE_EVIDENCE_SECONDS=2
GUARD_MIN_CLOSED_SECONDS=2
GUARD_EYE_EVIDENCE_MAX_GAP_SECONDS=1
GUARD_MIN_EYE_COVERAGE=0.60
GUARD_PERCLOS_WINDOW_SECONDS=30
GUARD_PERCLOS_THRESHOLD=0.60
GUARD_SLEEP_SUPPRESS_PHONE=true
GUARD_ALLOW_DEGRADED_SLEEP_ALERT=false
GUARD_SLEEP_FALLBACK_SECONDS=8

# Verify background motion before classifying guard movement.
GUARD_CAMERA_MOTION_ENABLED=true
GUARD_CAMERA_MOTION_WIDTH=320
GUARD_CAMERA_MOTION_MIN_POINTS=12
GUARD_CAMERA_MOTION_MIN_INLIERS=0.70
GUARD_CAMERA_MOTION_MAX_SCALE_CHANGE=0.15

# Confidence/class/model settings intentionally omitted: retain existing values.
# Selected guard box + ID + activity, without confidence or skeleton.
GUARD_DRAW_GUARD_BOX=true
GUARD_DRAW_GUARD_ID=true

# Use true only after confirming the deployment camera is physically fixed.
# Invalid/cropped boxes are still rejected with this option enabled.
GUARD_ASSUME_STATIC_CAMERA=false
GUARD_MOVEMENT_BORDER_MARGIN=0.015
GUARD_MOVEMENT_MAX_BOX_SCALE_CHANGE=0.25
GUARD_CAMERA_MOTION_MAX_FB_ERROR=1.5
GUARD_CAMERA_MOTION_MIN_SPREAD=0.12
GUARD_CAMERA_SCENE_DIFFERENCE=0.18

# Independent fresh eye evidence when body motion cannot be measured.
# Current phone evidence must also be available and show no phone.
GUARD_ALLOW_EYE_ONLY_SLEEP=true
GUARD_EYE_ONLY_MIN_SECONDS=4
GUARD_EYE_ONLY_PERCLOS=0.85
GUARD_EYE_ONLY_MIN_COVERAGE=0.75
GUARD_SLEEP_HEAD_ROLL_DEGREES=15
