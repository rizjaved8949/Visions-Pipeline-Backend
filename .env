FRONTEND_DIR= Path to frontend directory
GUARD_MONITORING_ENABLED='true'
GUARD_TEST_MODE=true

GUARD_UPLOAD_DIR=local_data/guard/uploads
GUARD_OUTPUT_ROOT=local_data/guard/outputs
GUARD_JOB_DB=local_data/guard/jobs.sqlite3

GUARD_WORKERS=1
GUARD_MAX_PENDING_JOBS=20
GUARD_MAX_UPLOAD_MB=500

GUARD_DETECTION_ENABLED=true
GUARD_TRACKING_ENABLED=true
GUARD_POSE_ENABLED=true
GUARD_PHONE_ENABLED=true
GUARD_EYES_ENABLED=true

GUARD_CONTINUE_ON_FRAME_ERROR=true

# Guard detector
GUARD_RFDETR_SIZE=medium
GUARD_RFDETR_WEIGHTS=guard_monitoring/weights/guard_rfdetr_large_best.pth
GUARD_RFDETR_TARGET_LABEL=
GUARD_REQUIRE_FINETUNED_GUARD_MODEL=true

# Pose / phone detectors
GUARD_POSE_WEIGHTS=guard_monitoring/weights/yolo26m-pose.pt
GUARD_PHONE_WEIGHTS=guard_monitoring/weights/yolo26m.pt

# Face / eyes
GUARD_FACE_LANDMARKER_MODEL=guard_monitoring/weights/face_landmarker.task


# ============================================================
# LIVE MONITORING
# ============================================================

# Laptop webcam testing: keep only one live session
GUARD_LIVE_MAX_SESSIONS=1

# AI analyzes about 3 frames/sec
GUARD_LIVE_ANALYSIS_FPS=3

# Retry camera after read failure
GUARD_LIVE_RECONNECT_SECONDS=2

# Quality of annotated live MJPEG stream
GUARD_LIVE_JPEG_QUALITY=80

....
GUARD_REID_ENABLED=true          # appearance ReID on/off
GUARD_PREDICT_DURING_GRACE=true  # Kalman predicted box during retention
GUARD_DRAW_ALL_PERSONS=true      # grey boxes for every tracked person
GUARD_DRAW_HUD=false             # bottom-left status panel
GUARD_ACTIVITY_MAPPING=evidence  # or "legacy" to restore old standing→Moving
GUARD_MOVEMENT_MIN_VISIBLE_AREA=0.75  # soft border rule (0=original strict)
GUARD_POSTURE_ASPECT_FALLBACK=true   # sitting inference fro


GUARD_HEAD_DROP_CONFIRM_SECONDS=3
GUARD_MAX_GUARDS=4
GUARD_PERCLOS_WINDOW_SECONDS=10
GUARD_FRAME_STATUS_ENABLED=true
GUARD_SLEEP_SUPPRESS_PHONE=false
KITCHEN_HYGIENE_ENABLED='true'
ATTENDANCE_ENABLED='true'
ALPR_ENABLED='true'
RESTRICTED_ZONE_ENABLED='true'

# ---------------------------------------------------------------------------
# Guard alert thresholds - how long a condition must hold before it raises a
# warning on the Duty timeline / Alert history.
#
# Re-read on every job and live session, so editing a value here takes effect
# on the NEXT run without restarting the backend. All values are seconds.
# Lower a number to get warnings out of short clips (e.g. GUARD_SLEEP_SECONDS=1
# will flag sleeping almost immediately); raise it for production cameras.
#
# These take precedence over GUARD_TEST_MODE, which otherwise supplies its own
# short defaults. The values below are exactly what test mode was already
# applying, so behaviour is unchanged until you edit them.
# ---------------------------------------------------------------------------

# Ignore the first N seconds of a run entirely (lets tracking settle).
GUARD_RULE_WARMUP_SECONDS=0

# How long each condition must persist before it becomes an alert.
GUARD_SLEEP_SECONDS=3
GUARD_PHONE_SECONDS=5
GUARD_STATIONARY_SECONDS=8
GUARD_ABSENCE_SECONDS=5

# Grace period before a condition that briefly disappears is treated as over -
# stops a dropped frame from resetting an episode that is still happening.
GUARD_SLEEP_GRACE_SECONDS=10
GUARD_PHONE_GRACE_SECONDS=3
GUARD_STATIONARY_GRACE_SECONDS=3
GUARD_ABSENCE_GRACE_SECONDS=1

# How long an unreadable/unknown status persists before the rule state resets,
# and the largest gap in evidence a single episode may contain.
GUARD_UNKNOWN_RESET_SECONDS=5
GUARD_MAX_EVIDENCE_GAP_SECONDS=2

# ---------------------------------------------------------------------------
# Kitchen Hygiene display
# ---------------------------------------------------------------------------

# The per-staff PPE status panel drawn into the right-hand side of the video.
# Off: the same information is shown live in the page's KPIs, compliance chart,
# per-person list and violation feed instead of being baked into the frame.
# Set to true to restore the old in-frame panel.
KITCHEN_SHOW_SIDE_PANEL=false
